# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins (required in production behind nginx)
# CSRF_TRUSTED_ORIGINS=https://example.com

# PostgreSQL
DATABASE_URL=postgres://juzi:juzi@localhost:5432/juzi_development
POSTGRES_TEST_DB=juzi_test

# CORS (Preact/Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# Card review in Word admin. Leave blank to disable Analyze.
OPENROUTER_API_KEY=

# Sentry backend: blank DSN disables reporting. Explicitly set a DSN to test locally.
SENTRY_DSN=
SENTRY_RELEASE=
# Frontend uses frontend/.env.local (Vite does not load this root .env).
# VITE_SENTRY_DSN=
# VITE_SENTRY_RELEASE=
